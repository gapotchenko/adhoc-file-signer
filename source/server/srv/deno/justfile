set fallback
set dotenv-load

[windows]
set shell := ["gnu-tk", "-i", "-c"]
[windows]
set script-interpreter := ["gnu-tk", "-i", "-l", "sh", "-eu"]

export DENO_FUTURE := "1"

# -----------------------------------------------------------------------------

@help:
    just --list

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

# Start IDE using the project environment
[group("development")]
[windows]
develop:
    start "" *.code-workspace

# Start IDE using the project environment
[group("development")]
[unix]
develop:
    open *.code-workspace

# Format source code
[group("development")]
format:
    deno fmt

# Format source code
[group("development")]
check:
    deno check

# Lint source code
[group("development")]
lint:
    deno lint

# -----------------------------------------------------------------------------
# Diagnostics
# -----------------------------------------------------------------------------

# Run the development server in debug mode
[group("diagnostics")]
serve:
    GP_ADHOC_FILE_SIGNER_API_KEY=123456 ./run.sh develop
