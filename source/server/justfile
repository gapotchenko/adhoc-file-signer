set dotenv-load

[windows]
set shell := ["gnu-tk", "-i", "-c"]
[windows]
set script-interpreter := ["gnu-tk", "-i", "-l", "sh", "-eu"]

# -----------------------------------------------------------------------------

@help:
    just --list

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

# Format source code
[group("development")]
[script]
format:
    echo 'Formatting **/*.md...'
    deno fmt **/*.md
    echo 'Formatting **/*.sh...'
    find . -type d -name '.?*' -prune -o -type f -name '*file' -prune -o -type f \( ! -name '*.*' -o -name '*.sh' \) -exec shfmt -l -w {} \;
    echo 'Formatting **/justfile...'
    find . -type d -name '.?*' -prune -o -type f -name justfile -exec just --fmt --justfile {} \;
    echo 'Formatting opt/server...'
    (cd srv/deno; just format)

# Check source code
[group("development")]
[script]
check:
    echo 'Checking **/*.sh...'
    find . -type d -name '.?*' -prune -o -type f -name '*file' -prune -o -type f \( ! -name '*.*' -o -name '*.sh' \) -exec shellcheck {} \;
    echo 'Checking opt/server...'
    (cd srv/deno; just check)

# Lint source code
[group("development")]
lint:
    cd srv/deno; just lint
